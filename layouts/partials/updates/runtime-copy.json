{{- $labels := partial "updates/labels.html" (dict "ctx" .) -}}
{{- dict
  "site_update_prompt" (printf "%v" (index $labels "prompt"))
  "site_version_check" (printf "%v" (index $labels "check"))
  "site_version_checking" (printf "%v" (index $labels "checking"))
  "site_version_check_failed" (printf "%v" (index $labels "check_failed"))
  "site_version_unavailable" (printf "%v" (index $labels "unavailable"))
  "site_version_status" (printf "%v" (index $labels "status"))
  "site_version_status_current" (printf "%v" (index $labels "status_current"))
  "site_version_status_ready" (printf "%v" (index $labels "status_ready"))
  "site_version_status_offline" (printf "%v" (index $labels "status_offline"))
  "site_version_status_click_update" (printf "%v" (index $labels "status_click_update"))
  "site_version_status_click_retry" (printf "%v" (index $labels "status_click_retry"))
| jsonify -}}
